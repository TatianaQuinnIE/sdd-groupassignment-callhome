# Copy to .env and choose your own passwords. Never commit .env.
# SQL Server needs 8+ characters with 3 of: uppercase, lowercase, number, symbol.
DB_SA_PASSWORD=ChangeMe-Str0ng!Pass

# One login per service, each with access to its own database only (db/init.sql).
CONTACTS_DB_PASSWORD=ChangeMe-Contacts1!
OVERLAP_DB_PASSWORD=ChangeMe-Overlap1!
